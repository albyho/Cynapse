{
  "name": "cynapse-jupyterlab-adapter",
  "version": "0.11.0",
  "private": true,
  "description": "Cynapse JupyterLab Adapter: the prebuilt extension and its Protocol connection client.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "cynapse_jupyterlab_extension/labextension/**/*"
  ],
  "scripts": {
    "precompile": "pnpm --filter @cynapse/adapter-kit build",
    "compile": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "format:check": "prettier --check src",
    "test": "pnpm compile && node --test --test-reporter=dot \"out/*.test.js\"",
    "prebuild:lib": "pnpm --filter @cynapse/adapter-kit build",
    "build:lib": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:extension": "pnpm build:lib && node scripts/buildExtension.mjs",
    "build:wheel": "python -m pip wheel . --no-deps -w dist",
    "clean:extension": "node -e \"const fs=require('node:fs');for(const p of ['lib','out','dist','cynapse_jupyterlab_extension/labextension'])fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cynapse/adapter-kit": "workspace:*",
    "@jupyterlab/application": "^4.6.6",
    "@jupyterlab/apputils": "^4.6.6",
    "@jupyterlab/cells": "^4.6.6",
    "@jupyterlab/docmanager": "^4.6.6",
    "@jupyterlab/filebrowser": "^4.6.6",
    "@jupyterlab/notebook": "^4.6.6",
    "@jupyterlab/services": "^7.6.6"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.3.0",
    "@jupyterlab/core-meta": "^4.6.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "css-loader": "^7.1.4",
    "prettier": "^3.10.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "cynapse_jupyterlab_extension/labextension"
  }
}
