{
  "step_id": "manual_stop",
  "title": "Manual Stop: long-running Cell",
  "actions": [
    {
      "type": "JupyterLabCellInsert",
      "path": "lesson.ipynb",
      "cell_id": "cynapse_long",
      "after_cell_id": "setup",
      "cell_type": "code",
      "source": ""
    },
    {
      "type": "JupyterLabCellInsertText",
      "path": "lesson.ipynb",
      "cell_id": "cynapse_long",
      "speed_ms": 1,
      "target": {
        "eof": true
      },
      "text": "import time\ntime.sleep(10)\nprint('long done')\n"
    },
    {
      "type": "JupyterLabCellRun",
      "path": "lesson.ipynb",
      "timeout_ms": 30000,
      "from_cell_id": "cynapse_long",
      "to_cell_id": "cynapse_long"
    }
  ]
}
